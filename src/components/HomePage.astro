---
/**
 * Home (pillar): every 2027 public holiday by state, the countdown to the next one, key figures, the folded answer,
 * the tools as cards, the page groups, long texts in accordions, the FAQ. Text: src/content/home.ts; data: engine.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME;
const path = route('home', lang);
const h = helpers(lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const tools = GUIDES.filter((p) => ['next-public-holiday', 'long-weekends-2027', 'annual-leave-planner-2027', 'school-terms-2027', 'easter-2027', 'public-holidays-2028'].includes(p.id) && hasRoute(p.id, lang));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil data-chrome><Tool kind="st" lang={lang} arg={{ state: 'nsw', year: 2027 }} idPrefix="home" /></div>
  <div data-chrome class="mt-4"><Tool kind="countdown" lang={lang} idPrefix="home-c" /></div>
  <dl data-chrome class="limits my-6 text-sm">
    {x.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
  </dl>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.toolsTitle}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((p) => <li class="rounded-lg border border-navy-200 bg-white p-4"><a href={route(p.id, lang)} class="font-semibold text-accent-700 underline-offset-2 hover:underline">{p.en.nav}</a><span class="mt-1 block text-sm text-navy-600">{p.en.card}</span></li>)}
    </ul>
    <p class="mt-4 text-sm text-navy-700"><a href={route('method', lang)} class="font-medium text-accent-700 underline">How the dates are found and checked</a> · <a href={route('about', lang)} class="font-medium text-accent-700 underline">Who runs this site</a></p>
  </section>
  <section class="mt-10"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10" data-chrome>
    {GROUPS.map((g) => {
      const list = GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h2 class="text-xl font-bold text-navy-900">{g.label[lang]}</h2>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.en.nav}</a><span class="block text-navy-600">{p.en.card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
</PageLayout>
