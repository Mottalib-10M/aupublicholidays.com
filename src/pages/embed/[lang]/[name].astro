---
/** Page to embed (iframe): only the countdown to the next public holiday. noindex, not in the sitemap. */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import type { Lang } from '../../../lib/format';
export function getStaticPaths() { return [{ params: { lang: 'en', name: 'next-holiday' } }]; }
const { lang } = Astro.params as { lang: Lang; name: string };
const page = `${SITE_URL}${route('next-public-holiday', lang)}`;
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Next public holiday in your state (embed)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind="countdown" lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · What you choose stays on your device · tool by Radif Partners, not a government service<br />Public holiday lists of the NSW and Queensland governments: <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank" class="underline">CC BY 4.0</a>, adapted, calculations by Radif Partners</p>
  </body>
</html>
